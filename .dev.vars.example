# Copy to `.dev.vars` for local testing with `npx wrangler pages dev dist`.
# `.dev.vars` is gitignored. In production these are set in the Cloudflare
# dashboard: Workers & Pages -> the-mess-junk -> Settings -> Environment variables.

# Required for the enquiry form + newsletter to send email.
# Get one at https://resend.com (free tier: 3,000 emails/month).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Overrides the destination inbox without a redeploy.
CONTACT_TO=themessjunk@gmail.com

# Optional fallback. A Google Apps Script web-app URL that appends the
# submission to a Sheet — used automatically if Resend is missing or failing.
# SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfy.../exec

# Optional. Switches newsletter signups to Buttondown instead of emailing them.
# BUTTONDOWN_API_KEY=
