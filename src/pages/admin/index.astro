---
/**
 * Admin dashboard — what needs attention, and where to go.
 *
 * Leads with the things that actually go stale (sessions running out, seats
 * filling up) rather than a generic count of everything, because those are the
 * only items with a deadline attached.
 */
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';
import { requireSession } from '../../lib/admin';
import { getAllWorkshops, getFaq, getPricingTiers, getUpcomingDates } from '../../lib/db';
import { formatDate } from '../../data/site';

const denied = await requireSession(Astro);
if (denied) return denied;

let error = '';
let workshops: Awaited<ReturnType<typeof getAllWorkshops>> = [];
let faq: Awaited<ReturnType<typeof getFaq>> = [];
let tiers: Awaited<ReturnType<typeof getPricingTiers>> = [];
let dates: Awaited<ReturnType<typeof getUpcomingDates>> = [];

try {
  [workshops, faq, tiers, dates] = await Promise.all([
    getAllWorkshops(),
    getFaq(),
    getPricingTiers(),
    getUpcomingDates(),
  ]);
} catch (err) {
  console.error(err);
  error =
    err instanceof Error && err.message.includes('DATABASE_URL')
      ? 'DATABASE_URL is not set, so the admin panel cannot reach the database. See the README.'
      : 'Could not reach the database. Try again in a moment.';
}

const live = workshops.filter((w) => !w.draft).length;
const drafts = workshops.length - live;

/* Sessions with few seats left are the thing most likely to need a same-day
   edit, so they are surfaced rather than buried in the dates list. */
const nearlyFull = dates.filter(
  (d) => d.seatsLeft > 0 && d.seatsLeft <= Math.max(2, Math.ceil(d.seatsTotal * 0.25)),
);
const soldOut = dates.filter((d) => d.seatsLeft === 0);

const sections: { label: string; href: string; icon: IconName; count: number; note: string }[] = [
  {
    label: 'Workshops',
    href: '/admin/workshops/',
    icon: 'palette',
    count: workshops.length,
    note: drafts > 0 ? `${live} live, ${drafts} hidden` : `${live} live`,
  },
  {
    label: 'Upcoming dates',
    href: '/admin/dates/',
    icon: 'calendar',
    count: dates.length,
    note: dates.length === 0 ? 'none scheduled' : `next on ${formatDate(dates[0].date)}`,
  },
  {
    label: 'Pricing',
    href: '/admin/pricing/',
    icon: 'ticket',
    count: tiers.length,
    note: `${tiers.length} tiers on the pricing page`,
  },
  {
    label: 'FAQ',
    href: '/admin/faq/',
    icon: 'lightbulb',
    count: faq.length,
    note: `${faq.length} questions answered`,
  },
];
---

<AdminLayout title="Dashboard">
  <h1 class="text-display-md">Content</h1>
  <p class="mt-2 max-w-prose text-body-md text-ink-soft">
    Edit anything here and the website updates itself a minute or so after you save.
  </p>

  {
    error && (
      <p
        role="alert"
        class="mt-6 rounded-card-sm border border-error/40 bg-error/5 px-4 py-3 text-body-sm text-error"
      >
        {error}
      </p>
    )
  }

  {
    !error && (
      <>
        {(dates.length === 0 || nearlyFull.length > 0 || soldOut.length > 0) && (
          <section class="mt-8 rounded-card border border-line bg-white p-6">
            <h2 class="font-display text-[1.1rem] font-bold tracking-tight">Worth a look</h2>
            <ul class="mt-3 space-y-2 text-body-sm">
              {dates.length === 0 && (
                <li class="flex gap-2.5">
                  <Icon name="calendar" size={17} class="mt-0.5 shrink-0 text-error" />
                  <span>
                    <strong class="font-semibold">No upcoming dates.</strong>{' '}
                    <span class="text-ink-soft">
                      The Contact page cannot show anything to book.
                    </span>{' '}
                    <a href="/admin/dates/new/" class="text-cobalt underline underline-offset-4">
                      Add one
                    </a>
                  </span>
                </li>
              )}
              {nearlyFull.map((d) => (
                <li class="flex gap-2.5">
                  <Icon name="users" size={17} class="mt-0.5 shrink-0 text-cobalt" />
                  <span>
                    <strong class="font-semibold">{d.workshop}</strong>{' '}
                    <span class="text-ink-soft">
                      on {formatDate(d.date)} has only {d.seatsLeft} seat
                      {d.seatsLeft === 1 ? '' : 's'} left.
                    </span>{' '}
                    <a href={`/admin/dates/${d.id}/`} class="text-cobalt underline underline-offset-4">
                      Update
                    </a>
                  </span>
                </li>
              ))}
              {soldOut.map((d) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={17} class="mt-0.5 shrink-0 text-ink-soft" />
                  <span class="text-ink-soft">
                    <strong class="font-semibold text-ink">{d.workshop}</strong> on{' '}
                    {formatDate(d.date)} is full.
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <ul class="mt-6 grid gap-5 sm:grid-cols-2">
          {sections.map((s) => (
            <li>
              <a href={s.href} class="card card-interactive group flex h-full items-start gap-4 p-6">
                <span class="mt-0.5 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-pill bg-cobalt-05">
                  <Icon name={s.icon} size={21} class="text-cobalt" />
                </span>
                <span class="flex-1">
                  <span class="flex items-center justify-between gap-3">
                    <span class="font-display text-[1.15rem] font-bold tracking-tight">
                      {s.label}
                    </span>
                    <Icon
                      name="arrow-right"
                      size={18}
                      class="shrink-0 text-cobalt transition-transform duration-300 ease-brand group-hover:translate-x-0.5"
                    />
                  </span>
                  <span class="mt-1 block text-body-sm text-ink-soft">{s.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</AdminLayout>
