---
/**
 * FAQ list, grouped by the three sections the public page uses.
 *
 * Grouped rather than flat because `order` only sorts within a section — a
 * single flat list would make the numbers look wrong.
 */
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { requireSession, friendlyDbError } from '../../../lib/admin';
import { getFaq, FAQ_GROUPS, type FaqGroup } from '../../../lib/db';

const denied = await requireSession(Astro);
if (denied) return denied;

const GROUP_LABELS: Record<FaqGroup, string> = {
  booking: 'Booking & availability',
  pricing: 'Pricing & group size',
  expect: 'What to expect',
};

let faq: Awaited<ReturnType<typeof getFaq>> = [];
let error = '';

try {
  faq = await getFaq();
} catch (err) {
  error = friendlyDbError(err);
}

const grouped = FAQ_GROUPS.map((g) => ({
  id: g,
  label: GROUP_LABELS[g],
  items: faq.filter((f) => f.group === g),
}));

const saved = Astro.url.searchParams.get('saved');
const deleted = Astro.url.searchParams.get('deleted');
---

<AdminLayout title="FAQ">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-display-md">FAQ</h1>
      <p class="mt-2 max-w-prose text-body-md text-ink-soft">
        {faq.length} questions. Good answers here can show up directly in Google results.
      </p>
    </div>
    <a href="/admin/faq/new/" class="btn btn-primary">
      <Icon name="plus" size={18} />
      Add a question
    </a>
  </div>

  {
    (saved || deleted) && (
      <p role="status" class="mt-6 rounded-card-sm border border-success/40 bg-success/5 px-4 py-3 text-body-sm text-success">
        {deleted ? 'Question deleted.' : 'Saved.'} The website will show the change in about a minute.
      </p>
    )
  }

  {
    error && (
      <p role="alert" class="mt-6 rounded-card-sm border border-error/40 bg-error/5 px-4 py-3 text-body-sm text-error">
        {error}
      </p>
    )
  }

  <div class="mt-8 space-y-8">
    {
      grouped.map((g) => (
        <section>
          <h2 class="font-display text-[1.15rem] font-bold tracking-tight">{g.label}</h2>
          {g.items.length === 0 ? (
            <p class="mt-2 rounded-card border border-line bg-white px-5 py-4 text-body-sm text-ink-soft">
              Nothing in this section yet.
            </p>
          ) : (
            <ul class="mt-3 divide-y divide-line overflow-hidden rounded-card border border-line bg-white">
              {g.items.map((f) => (
                <li>
                  <a
                    href={`/admin/faq/${f.id}/`}
                    class="group flex items-center gap-4 px-5 py-4 transition-colors hover:bg-cobalt-05"
                  >
                    <span class="w-8 shrink-0 text-body-sm tabular-nums text-ink-soft">{f.order}</span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-medium">{f.question}</span>
                      <span class="mt-0.5 block truncate text-body-sm text-ink-soft">{f.answer}</span>
                    </span>
                    <Icon name="chevron-right" size={18} class="shrink-0 text-ink-soft group-hover:text-cobalt" />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</AdminLayout>
