const isBrandGlyph = name === 'whatsapp';
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg
  class:list={['inline-block shrink-0', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isBrandGlyph ? 'currentColor' : 'none'}
  stroke={isBrandGlyph ? 'none' : 'currentColor'}
  stroke-width={isBrandGlyph ? undefined : stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  focusable="false"
  {...a11y}
  set:html={PATHS[name] ?? ''}
/>
