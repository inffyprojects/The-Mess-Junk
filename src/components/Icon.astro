---
/**
 * Icon — design doc §3.5
 *
 * "Use a single consistent line-icon set — Phosphor Icons or Lucide. Never mix
 * icon families, never use emoji as functional icons."
 *
 * These are Lucide paths (24x24 grid, 2px stroke, round caps/joins, ISC
 * licensed), inlined so there is no icon-font request and no runtime JS. Every
 * icon in the project comes from this file — adding a one-off SVG elsewhere
 * breaks the §3.5 rule, so add new glyphs to the table below instead.
 *
 * There is exactly one exception, and it is deliberate: `whatsapp` is a filled
 * brand glyph, not a Lucide line icon. A recognisable WhatsApp mark is doing
 * product-identification work, and an approximated line-art version reads as
 * wrong. It is rendered with fill, not stroke — see the branch in the markup.
 */

import type { IconName } from '../data/icons';

interface Props {
  name: IconName;
  size?: number;
  /** Lucide default is 2; the doc allows 1.5–2 (§3.5) */
  stroke?: number;
  class?: string;
  /** Set only when the icon is the sole content of a control */
  label?: string;
}

const { name, size = 20, stroke = 1.75, class: className = '', label } = Astro.props;

