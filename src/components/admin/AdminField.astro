---
/**
 * One labelled form control for the admin panel.
 *
 * Exists so every field in the panel gets a label, a hint and consistent
 * spacing without each page re-deriving it. The editors are not developers —
 * a field without a hint is a field they will guess at.
 */
interface Props {
  label: string;
  name: string;
  hint?: string;
  required?: boolean;
  class?: string;
}

const { label, name, hint, required = false, class: className = '' } = Astro.props;
---

<div class={className}>
  <label class="field-label" for={name}>
    {label}
    {required && <span class="text-error" aria-hidden="true">*</span>}
  </label>
  <slot />
  {hint && <p class="mt-1.5 text-body-sm text-ink-soft">{hint}</p>}
</div>
