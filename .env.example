# Copy to `.env` for local development. `.env` is gitignored.
# In production these go in the Vercel dashboard:
#   Project -> Settings -> Environment Variables
#
# Every one of these is required for a working deploy except DEPLOY_HOOK_URL,
# without which content edits save but the public site will not rebuild.

# --- Database -------------------------------------------------------------
# Neon connection string. Use the POOLED connection string from the Neon
# dashboard (the one containing "-pooler"), which suits serverless best.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Admin panel ----------------------------------------------------------
# Generate both of these with:  npm run admin:hash -- "your-password-here"
# The password itself is never stored anywhere.
ADMIN_PASSWORD_HASH=210000:0123456789abcdef...:fedcba9876543210...
SESSION_SECRET=at-least-32-characters-of-random-text-goes-here

# --- Rebuild trigger ------------------------------------------------------
# Vercel -> Project -> Settings -> Git -> Deploy Hooks -> create one.
# Saving in the admin panel POSTs here so the public pages rebuild.
DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxxxx

# --- Email (enquiry form + newsletter) ------------------------------------
# https://resend.com — free tier, 3,000 emails/month.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: send enquiries somewhere other than themessjunk@gmail.com
# CONTACT_TO=themessjunk@gmail.com

# Optional fallback: a Google Apps Script webhook that appends form
# submissions to a Sheet. Used automatically if Resend fails.
# SHEET_WEBHOOK_URL=

# Optional: send newsletter signups to a Buttondown list instead of email.
# BUTTONDOWN_API_KEY=
